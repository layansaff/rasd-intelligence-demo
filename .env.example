# Local API storage. Keep database files private and back them up.
RASD_DATABASE_PATH=./data/rasd.sqlite3

# Set to true only for a public portfolio demo. Visitor assessments are not stored.
RASD_DEMO_MODE=false

# Only applies when the frontend is served from another local origin.
# For deployment, specify each trusted origin explicitly.
RASD_CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
